.env
.env.*
.venv/
__pycache__/
*.pyc
runs/raw/
docs/
runs/**/*.log

# Harbor: raw job outputs (large; regenerated by `harbor run`). Per-trial rows are committed in
# harbor/results.jsonl via `scripts/harbor_tasks.py summary harbor/jobs/<job> --append-results`.
harbor/jobs/
# Harbor: generated by `scripts/harbor_tasks.py sync` — copies of harbor/_shared, and setup.json
# rendered from each task.toml's [metadata.chain].
harbor/*/environment/chain/setup.json
harbor/*/environment/Dockerfile
harbor/*/environment/docker-compose.yaml
harbor/*/environment/chain/Dockerfile
harbor/*/environment/chain/node.py
harbor/*/tests/chainlib.py
harbor/*/tests/test.sh
!harbor/_shared/**
